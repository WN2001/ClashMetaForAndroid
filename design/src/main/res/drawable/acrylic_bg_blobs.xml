<?xml version="1.0" encoding="utf-8"?>
<!--
    亚克力背景：三个大半径径向渐变色斑，模拟 Win11 Acrylic 后透出的壁纸光晕。
    色斑用品牌蓝紫的低透明度：浅色主题下呈淡雅色晕，深色主题下呈微光玻璃感。
    半透明卡面（colorAcrylicCard）叠在其上即产生磨砂层次。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 左上主色斑 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.06"
                android:gradientRadius="480dp"
                android:startColor="#3D445AC0"
                android:endColor="#00445AC0" />
        </shape>
    </item>
    <!-- 右侧亮蓝斑 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.98"
                android:centerY="0.38"
                android:gradientRadius="400dp"
                android:startColor="#2E6A8DF5"
                android:endColor="#006A8DF5" />
        </shape>
    </item>
    <!-- 左下辅助斑 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.95"
                android:gradientRadius="430dp"
                android:startColor="#29445AC0"
                android:endColor="#00445AC0" />
        </shape>
    </item>
</layer-list>
